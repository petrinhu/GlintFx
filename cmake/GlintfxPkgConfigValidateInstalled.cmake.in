# SPDX-License-Identifier: AGPL-3.0-or-later
#
# GlintfxPkgConfigValidateInstalled.cmake.in - PKG-VALIDATE / PKG-NATIVE.
#
# Configured with configure_file(@ONLY) by
# glintfx_register_pkgconfig_validation() (cmake/GlintfxPkgConfigValidate.cmake)
# into <build>/GlintfxPkgConfigValidateInstalled.cmake, then
# include()-d from ONE install(CODE) line appended right after
# glintfx.pc's own install(FILES ...) (glintfx_install_pkgconfig(),
# cmake/GlintfxInstall.cmake). By the time this file runs, glintfx.pc,
# the public headers and the library artifact are already on disk, in
# whatever real layout THIS `cmake --install` invocation actually
# produced, on the machine actually running it - a packager we have
# never met, using a layout tests/tools/check_pkgconfig.sh (PKG-DIST)
# never enumerated (GODS_LAWS.md LEI ZERO: the base of consumers is
# public and unknown, so a validator that only runs in our CI leaves
# every layout outside it unchecked, silently).
#
# PKG-NATIVE (27/08/2026) - THE HAND-WRITTEN READER IS GONE. Decision
# of the lider (ESCOPO.md paragraph 7, "A exigencia minima da
# ferramenta de build SOBE, e o leitor caseiro morre"): the
# hand-written pkg-config text reader that used to live in this file
# (glintfx_pkgconfig_read_raw_variables(), glintfx_pkgconfig_resolve_variables(),
# glintfx_pkgconfig_substitute_text(), glintfx_pkgconfig_lookup_variable(),
# glintfx_pkgconfig_read_field() - all now deleted) was reopened by
# adversarial review FIVE times in two days, always the same family: a
# path fragment entering from one more source without being made
# absolute first (relative --prefix, relative DESTDIR, CWD-dependent
# resolution of a relative includedir/libdir/-I/-L value). GODS_LAWS.md
# L-42 ("uma falha revista mais de uma vez -> buscar na web"): CMake's
# OWN build-in pkg-config format parser, cmake_pkg_config(), added in
# CMake 3.31 (EXTRACT only) and completed with IMPORT/POPULATE in
# CMake 4.1 - "generates CMake variables and targets from pkg-config
# format package files natively, without needing to invoke or even
# require the presence of a pkg-config implementation" (CMake's own
# documentation, cmake_pkg_config.html) - now does every byte of
# tokenizing, comment-stripping, whitespace-around-"=" handling,
# Cflags:/Libs: field splitting and "-I"/"-L"/"-l" token extraction
# this file used to hand-roll. cmake_minimum_required(VERSION 4.1) in
# the root CMakeLists.txt is the reason this project's floor moved
# (see that file's own comment, and PACKAGING.md's "CMake version
# requirement" section, for which of the five platforms needed a CI
# install step to reach it - measured, not assumed: Fedora 44 ships
# 4.3.0, Arch and CachyOS ship 4.4.2, all comfortably above the floor
# with no CI step needed; Ubuntu 24.04's apt and the windows-latest
# GitHub Actions runner both ship BELOW 4.1 (3.28.3 and 3.31.6
# respectively, the second one measured against actions/runner-images'
# own Windows2025-Readme.md, not assumed from the Linux-only text of
# ESCOPO.md's own decision 7) and both get an explicit CMake-install
# step in .github/workflows/ci.yml).
#
# READ glintfx_pkgconfig_canonicalize_declarations()'s OWN COMMENT
# FIRST: the two STRICT guarantees described below (duplicate
# refused, everything defined before use) held up to CMake 4.4 only.
# From CMake 4.5.0 on, glintfx enforces both itself (defined-before-
# use for a variable's value; a field's undeclared reference is an
# empty text on every CMake version), and also refuses, itself, a
# line that is not a declaration and a lone "$", as CMake 4.1-4.4
# did.
#
# STRICTNESS STRICT (this file's every cmake_pkg_config() call) is the
# strictest mode the command offers - "closely mirrors the behavior of
# the original FDO pkg-config: variables and keywords must be unique
# [and] must be defined before they are used" (CMake's own
# documentation). Two MEASURED consequences worth naming plainly,
# because they are a real behavior change from the reader this file
# used to carry, not an accident:
#   - A glintfx.pc with the SAME variable defined twice, which the OLD
#     hand-written reader used to accept (last definition wins,
#     matching real pkgconf's own PERMISSIVE behavior) now FAILS
#     CLOSED under STRICT instead - measured live on this machine
#     (CMake 4.3.0): a two-line "libdir=" file that used to pass now
#     reports "cmake_pkg_config Resolution failed". This is a
#     narrowing, not a regression: glintfx's OWN generated glintfx.pc
#     never defines a variable twice (PACKAGING.md already documented
#     this as a property of glintfx.pc.in and cmake/GlintfxInstall.cmake,
#     unchanged by this fatia), so this only ever rejects a
#     hand-edited or packager-modified file that was already ambiguous
#     - and rejecting an ambiguous file is what "the strictest mode it
#     offers" is FOR.
#   - "${pcfiledir}" - pkg-config's own built-in for "the directory
#     this .pc file is actually in", which glintfx.pc.in's whole
#     relocatable-prefix design depends on ("prefix=${pcfiledir}/../..")
#     - is NOT a variable cmake_pkg_config() resolves on its own.
#     MEASURED, twice, two different ways (an absolute PC_FILE argument
#     and a PC_LIBDIR-searched package name): "${pcfiledir}" is silent-
#     empty under the default STRICTNESS PERMISSIVE, and a hard
#     "Resolution failed" under STRICT ("must be defined before used" -
#     pcfiledir is never assigned by a "key=value" line, because it is
#     supposed to be a BUILT-IN). Searched for a CMake issue tracker
#     entry naming this gap explicitly (L-42) and found none; the CMake
#     documentation for cmake_pkg_config() (fetched 27/08/2026) never
#     mentions "pcfiledir" at all, in either direction. Confirmed as a
#     genuine, present-day gap in this version of the native
#     mechanism, not a usage mistake on this file's part.
#
#     THE FIX, and one of the TWO hand-written text operations this
#     file performs (the other one, needed from CMake 4.5.0 on, is
#     glintfx_pkgconfig_canonicalize_declarations()): glintfx_pkgconfig_prepare_native_input() below
#     copies glintfx.pc's own text to a private SCRATCH file (never the
#     real installed glintfx.pc - a packager's install tree is never
#     written to by this validation) and replaces the literal token
#     "${pcfiledir}" with pc_file's own, already-absolute PARENT_PATH -
#     a value this file already computes today for exactly this
#     purpose, never predicted, never CWD-dependent. This is a single,
#     universally-quoted, exact-substring string(REPLACE ...) - not a
#     parser, not a tokenizer, not a variable-resolution engine: those
#     three things are exactly what cmake_pkg_config() now does, on the
#     SUBSTITUTED file, in the ONE call this file makes to it. Every
#     other pkg-config syntax question (except the line-level ones
#     glintfx_pkgconfig_canonicalize_declarations() settles - see its
#     own comment - "${var}" chains through prefix/exec_prefix/
#     libdir/includedir, Cflags:/Libs: tokenizing) is answered by CMake
#     itself from this point on.
#
# WHAT THIS DOES NOT TRY TO HANDLE, DECLARED (GODS_LAWS.md L-27,
# honest downgrade over silent overclaiming):
#   - Cross-compilation needs nothing special here: every check below
#     either reads the filesystem/calls cmake_pkg_config() (no binary
#     involved at all - see "Talking to the pkg-config BINARY itself"
#     below) or runs `pkg-config`/`pkgconf`, a HOST tool operating on
#     text (the one binary-conversation check) - neither ever executes
#     the target-arch library or an object file, so nothing here is
#     target-arch sensitive.
#   - Component-scoped installs (`cmake --install --component X`) need
#     nothing special either, and this is a property of THIS PROJECT
#     today, not a general claim: none of glintfx's install() rules
#     (library, headers, CMake package, glintfx.pc, and this
#     validation's own install(CODE)) declare a COMPONENT, so they all
#     share the implicit default component, and a `--component <name>`
#     install for any OTHER name installs NOTHING for glintfx at all -
#     this validation is skipped right along with it, for the same
#     reason, not by any special-casing here.
#   - What "Libs.private carries the right linker token for a static
#     build" MEANS (its content, and that it is genuinely load-bearing
#     for a real static link) is PKG-DIST's own, already-tested claim
#     (tests/tools/check_pkgconfig.sh's static scenario). This file
#     only proves every PATH glintfx.pc emits (via a plain,
#     non-`--static` `--cflags`/`--libs` query - the one every
#     consumer hits) resolves to something real.
#   - Windows library-artifact naming: RESOLVED (PKG-WIN-SCOPE,
#     revertido por ordem do lider, 27/08/2026). glintfx.pc is
#     installed on Windows the same as everywhere else, and the glob
#     below (glintfx_pkgconfig_library_glob_patterns()) matches
#     glintfx.lib too, alongside libglintfx.so*/libglintfx.a.
#   - Talking to the pkg-config BINARY itself, as opposed to reading
#     the filesystem/calling cmake_pkg_config(), is where this file
#     still draws its one platform-shaped line (unchanged by
#     PKG-NATIVE - this half never used the hand-written reader, and
#     is not what the lider's decision replaced). Every filesystem/
#     cmake_pkg_config()-only check runs UNCONDITIONALLY, before this
#     file ever tries to find or talk to a pkg-config binary, on every
#     platform, Windows included, with FATAL_ERROR veto power that
#     never downgrades. What DOES still talk to a real pkg-config
#     binary: confirming that a REAL pkg-config on THIS machine's PATH
#     also finds glintfx via `--exists` - a genuinely different claim
#     than "the content glintfx.pc describes is really on disk", and
#     the only one that can plausibly vary by which pkg-config a
#     packager happens to have. On GitHub Actions' windows-latest
#     runner, the only pkg-config on PATH is Strawberry Perl's
#     Pure-Perl `PkgConfig` reimplementation (`pkg-config.bat`), which
#     - MEASURED against a live fixture by
#     tools/ci/diagnose-win-pkgconfig.ps1 - resolves a bare
#     PKG_CONFIG_PATH value shaped like "C:/Users/.../pkgconfig" (no
#     explicit list separator) by falling back to POSIX-style splitting
#     on ':', which shreds the drive letter itself ("C:") into a bogus
#     one-letter search directory; the SAME value with an explicit
#     trailing ';' resolves correctly. That measured fix - append a
#     native list separator before talking to pkg-config on Windows -
#     is applied below, unchanged by PKG-NATIVE. If the conversation
#     with the binary still fails after that fix,
#     glintfx_validate_installed_pkgconfig() now (PKG-WIN-VALIDATE-FATAL,
#     decisao do lider, 09/09/2026) draws ONE more distinction before
#     deciding: a binary find_program() FOUND but could never even be
#     LAUNCHED (RESULT_VARIABLE holds a non-numeric error string, never
#     a real exit code - the ERROR_BAD_EXE_FORMAT class this same
#     section already measured) is still a DECLARED SKIP, a WARNING on
#     Windows, never a FATAL_ERROR, because there was no conversation to
#     have at all; but a binary genuinely FOUND and LAUNCHED (a real,
#     numeric exit code) that still REJECTS glintfx.pc now IS a
#     FATAL_ERROR, on Windows exactly like every other platform - it is
#     a real, reproducible failure of the conversation this validation
#     exists to prove, not a platform quirk to silently downgrade.
#     glintfx_pkgconfig_print_conversation_diagnosis() (defined further
#     down) prints everything a packager we have never met needs to
#     reproduce either outcome by hand: the filesystem/
#     cmake_pkg_config() content check above it already ran, on THIS
#     same invocation, and already had full veto power over whatever it
#     found.
#   - DESTDIR is Unix-only BY THE BUILD TOOL'S OWN DOCUMENTATION, not
#     by anything this file assumes: "DESTDIR may not be used on
#     Windows because installation prefix usually contains a drive
#     letter like in C:/Program Files which cannot be prepended with
#     some other prefix" (CMake's own envvar/DESTDIR.html, fetched
#     27/08/2026). glintfx_pkgconfig_validate_resolve_staged_dir()
#     below still reads $ENV{DESTDIR} unconditionally (a real packager
#     could still set it on Windows and get a nonsensical path - CMake
#     itself does not refuse it), but no scenario this project tests
#     combines DESTDIR with a Windows install, because no supported
#     Windows packaging pipeline does either.
#
# Two escape hatches, both named GLINTFX_SKIP_PKGCONFIG_VALIDATION on
# purpose (one name, two mechanisms, same intent): the CACHE option in
# cmake/GlintfxOptions.cmake, read at CONFIGURE time by
# glintfx_register_pkgconfig_validation() BEFORE this file is even
# generated (skips it for good, for this build directory); and the
# ENVIRONMENT variable read at the top of
# glintfx_validate_installed_pkgconfig() below, at INSTALL time -
# because a packaging pipeline that configures ONCE and installs
# SEVERAL times against different DESTDIR/--component values (a real
# pattern: RPM's `%install` section can invoke `%cmake_install` more
# than once) should not have to reconfigure the whole tree just to
# skip this one check on one of those invocations.
#
# Each function below does one thing (GODS_LAWS.md L-17).

# Forces `value` (a CMake variable NAME, passed by reference the way
# every other in-place helper in this file does) absolute, anchored to
# `base_directory` - a REQUIRED, EXPLICIT argument, never CMake's own
# implicit default (CMAKE_CURRENT_SOURCE_DIR, silently applied whenever
# BASE_DIRECTORY is left out of a raw cmake_path(ABSOLUTE_PATH ...)
# call). Two call sites in
# glintfx_pkgconfig_validate_resolve_staged_dir() below share this one
# atom instead of each repeating the same three-line pattern - the
# earlier shape of this file (PKG-WIN-SCOPE round 6, before PKG-NATIVE)
# fixed CMAKE_INSTALL_PREFIX's own relative-path doubling this way and
# left $ENV{DESTDIR} unfixed, which is the SAME class of bug one call
# site later: a real `cmake --install` resolves a relative --prefix
# AND a relative DESTDIR against the invoking process's CWD, the exact
# rule CMAKE_CURRENT_SOURCE_DIR already answers correctly in script
# mode (confirmed against a real generated cmake_install.cmake on this
# machine). A THIRD call site (glintfx_pkgconfig_validate_content_tokens()
# below, one per "-I"/"-L" token) shares this same atom too.
#
# PKG-WIN-SCOPE round 7 (05/09/2026, CI run 33944572704, job "Windows
# (primario)"): this function used to route EVERY value through
# cmake_path(ABSOLUTE_PATH ... BASE_DIRECTORY ...) unconditionally,
# even one that was already a FULL path by CMake's OWN classic notion.
# On a cmake actually BUILT for Windows, that classic notion and
# cmake_path()'s notion DISAGREE for a value like "/usr" - a
# root-directory ("/") with no root-name (no drive letter): CMake's
# OWN documentation for cmake_path(IS_ABSOLUTE) (cmake_path.html,
# fetched 05/09/2026) says plainly "on Windows ... the path must have
# both a root-name and a root-directory-separator to be considered
# absolute" and "IS_ABSOLUTE can be false while HAS_ROOT_DIRECTORY is
# true" - while CMake's classic, EVERY-platform rule
# (cmSystemTools::FileIsFullPath) has always treated a bare leading "/"
# as a full path, no drive letter required. Routing "/usr" through
# cmake_path(ABSOLUTE_PATH ... BASE_DIRECTORY ...) under the STRICTER
# rule silently BORROWED base_directory's own root-name (drive letter)
# to complete it - measured turning "/usr" into "D:/usr" - and the
# caller then concatenated that onto a DESTDIR carrying its OWN,
# DIFFERENT drive letter ("C:/Users/.../buildroot") as a plain string
# prefix, producing the impossible
# "C:/Users/.../buildrootD:/usr/lib/pkgconfig" the FATAL_ERROR at the
# bottom of this file reported - a real, GOOD install, reproved.
#
# THE FIX mirrors what a real `cmake --install` itself actually does
# here, not what cmake_path() would prefer: confirmed against this
# project's own generated `build/cmake_install.cmake` (line ~52), real
# CMake's own DESTDIR concatenation is
# `"$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/..."` - CMAKE_INSTALL_PREFIX
# used EXACTLY as configured (only a trailing "/" stripped, at the top
# of that generated file), never forced through cmake_path's own,
# stricter absolute-path machinery.
#
# WHY A HAND-WRITTEN string(MATCHES ...) TEST, NOT `if(IS_ABSOLUTE
# ...)`: that classic command WOULD give the right per-platform answer
# on a real Windows machine (leading "/" alone is enough there too),
# but MEASURED, live, on THIS (Linux) machine: `if(IS_ABSOLUTE "/usr")`
# and `cmake_path(IS_ABSOLUTE "/usr")` already AGREE (both TRUE) here,
# and drive-letter recognition for either command is compiled into the
# cmake BINARY itself only `#if defined(_WIN32)` - a COMPILE-TIME
# switch a script cannot flip with `-DWIN32=1` or any other CMake
# variable. Relying on either native command here would make this
# exact regression provable ONLY on a real Windows machine, which
# GODS_LAWS.md project L-04 ("o comportamento deve ser igual em
# qualquer OS ... provado em cada [sistema]") does not accept for a
# defect this project already measured. glintfx_pkgconfig_looks_rooted()
# below is a PORTABLE, string-only reimplementation of the exact same
# "leading separator, or drive-letter-plus-separator" test - proven,
# live on this machine (see the values it returns TRUE for: "/usr",
# "D:/usr", "C:\\stage", a UNC "\\\\server\\share" - and FALSE for a
# bare relative token or "./stage"), to behave IDENTICALLY regardless
# of which platform the calling cmake binary was built for, so the
# SAME branch this function takes on a real Windows machine can be
# proven, RED then GREEN, right here.
function(glintfx_pkgconfig_looks_rooted value out_var)
    if(value MATCHES "^([A-Za-z]:)?[/\\\\]")
        set(${out_var} TRUE PARENT_SCOPE)
    else()
        set(${out_var} FALSE PARENT_SCOPE)
    endif()
endfunction()

function(glintfx_pkgconfig_force_absolute value_var base_directory)
    set(_glintfx_absolute_value "${${value_var}}")
    glintfx_pkgconfig_looks_rooted("${_glintfx_absolute_value}" _glintfx_already_rooted)
    if(_glintfx_already_rooted)
        # Only NORMALIZE-d in place (collapsing "./"/".."/doubled
        # separators - a safe, base-free operation), never routed
        # through cmake_path(ABSOLUTE_PATH ... BASE_DIRECTORY ...): a
        # CLI `--prefix` override can hand this function a value like
        # "/var/tmp/x/./stage" that is already full but not yet tidy,
        # and NORMALIZE alone is what tidies it without risking the
        # drive-letter-borrowing this whole fix exists to stop.
        cmake_path(SET _glintfx_absolute_value NORMALIZE "${_glintfx_absolute_value}")
    else()
        # Genuinely relative (no leading separator, no drive letter at
        # all) - anchor to base_directory exactly as before; this is
        # the ONLY case this function ever needed the base_directory
        # argument for in the first place (the relative-libdir
        # CWD-attack scenario, tests/tools/check_pkgconfig_validate.py's
        # own scenario 12, still refuses exactly the same way after
        # this fix: a bare relative token is still "not rooted", so it
        # still takes this branch, unchanged).
        cmake_path(ABSOLUTE_PATH _glintfx_absolute_value BASE_DIRECTORY "${base_directory}" NORMALIZE)
    endif()
    set(${value_var} "${_glintfx_absolute_value}" PARENT_SCOPE)
endfunction()

# Resolves the STAGED (DESTDIR-aware) pkgconfig/ directory this
# install actually wrote glintfx.pc into - never a predicted value,
# only the same inputs GNUInstallDirs' own install() rules already
# used to decide where to write it for real. Unrelated to PKG-NATIVE's
# own subject (this resolves WHERE the file is, never WHAT is inside
# it - see this file's own header for why the reader that answers the
# second question is gone and this function is not).
function(glintfx_pkgconfig_validate_resolve_staged_dir out_var)
    cmake_path(SET _glintfx_configured_libdir NORMALIZE "@GLINTFX_NORMALIZED_INSTALL_LIBDIR@")

    if(IS_ABSOLUTE "${_glintfx_configured_libdir}")
        # GNUInstallDirs allows CMAKE_INSTALL_LIBDIR to be absolute (a
        # packager staging into a fixed system location outside
        # CMAKE_INSTALL_PREFIX) - install() ignores CMAKE_INSTALL_PREFIX
        # entirely for an already-absolute DESTINATION, so this branch
        # must too (same rule glintfx_compute_pkgconfig_relocatable_prefix()
        # in cmake/GlintfxInstall.cmake already applies to glintfx.pc's
        # OWN prefix= content). CMAKE_INSTALL_PREFIX never enters this
        # branch at all.
        set(_glintfx_dir_no_destdir "${_glintfx_configured_libdir}/pkgconfig")
    else()
        # A relative --prefix must resolve the SAME way `cmake --install`
        # itself resolves it - against the invoking process's CWD, not
        # glintfx.pc's own eventual pcfiledir - which is exactly what
        # omitting an explicit pcfiledir-style base and using
        # CMAKE_CURRENT_SOURCE_DIR (the invoking CWD in script mode)
        # gives glintfx_pkgconfig_force_absolute() here.
        set(_glintfx_prefix "${CMAKE_INSTALL_PREFIX}")
        glintfx_pkgconfig_force_absolute(_glintfx_prefix "${CMAKE_CURRENT_SOURCE_DIR}")
        cmake_path(APPEND _glintfx_prefix "${_glintfx_configured_libdir}" "pkgconfig"
            OUTPUT_VARIABLE _glintfx_dir_no_destdir)
    endif()

    if(DEFINED ENV{DESTDIR} AND NOT "$ENV{DESTDIR}" STREQUAL "")
        # DESTDIR is Unix-only by the build tool's own documentation
        # (see this file's header) - a real packaging pipeline that
        # sets it is staging into a subdirectory of its own choosing,
        # which real `cmake --install` resolves against the SAME
        # invoking-CWD rule as a relative --prefix (measured:
        # "-- Installing: <cwd>/<destdir>/..." from a real relative-
        # DESTDIR install on this machine). Forced absolute first,
        # through the same atom as CMAKE_INSTALL_PREFIX above, before
        # being concatenated onto an already-absolute destination -
        # deliberately a PLAIN STRING PREFIX, never cmake_path(APPEND),
        # which treats an absolute right-hand side as "replace the
        # base", the opposite of what DESTDIR means (mirrors what
        # CMake's own file(INSTALL) does internally, for the same
        # reason PACKAGING.md documents: "DESTDIR prepends to EVERY
        # destination, relative or absolute, without changing any path
        # baked into the installed files' own content").
        set(_glintfx_destdir "$ENV{DESTDIR}")
        glintfx_pkgconfig_force_absolute(_glintfx_destdir "${CMAKE_CURRENT_SOURCE_DIR}")
        set(_glintfx_staged_dir "${_glintfx_destdir}${_glintfx_dir_no_destdir}")
        cmake_path(SET _glintfx_staged_dir NORMALIZE "${_glintfx_staged_dir}")
        set(${out_var} "${_glintfx_staged_dir}" PARENT_SCOPE)
    else()
        set(${out_var} "${_glintfx_dir_no_destdir}" PARENT_SCOPE)
    endif()
endfunction()

# Filesystem patterns that name glintfx's own compiled library
# artifact, one glob per platform-shaped naming convention it is known
# to produce (cmake/GlintfxLibrary.cmake's OUTPUT_NAME "glintfx" is the
# same string on every platform; only the prefix/suffix a linker
# actually writes to disk differ). A single source of truth, shared by
# both content-check call sites below (GODS_LAWS.md L-17).
function(glintfx_pkgconfig_library_glob_patterns out_var)
    set(${out_var}
        "libglintfx.so*"
        "libglintfx.a"
        # glintfx.lib: Windows/MSVC ARCHIVE artifact
        # (cmake/GlintfxInstall.cmake's install(TARGETS ... ARCHIVE
        # DESTINATION ...)) - the SAME extension names both a shared
        # build's import library and a static build's archive there,
        # so one pattern covers both.
        "glintfx.lib"
        PARENT_SCOPE
    )
endfunction()

# CMAKE 4.5.0 CHANGED WHAT CMAKE'S OWN PARSER DOES WITH A .pc LINE
# (CMAKE45-PC, 13/11/2026, and its first adversarial review,
# CMAKE45-PC-FIX1). CMake 4.1 to 4.4 all ship the same pkg-config
# reader (llpkgc as imported on 19/07/2024); CMake 4.5.0 ships llpkgc
# 0.0.7 and a new resolver (upstream commit 38fa645e73, absent from
# v4.4.5, present in v4.5.0, not named in the 4.5 release notes).
# Measured in containers on 13/11/2026, CMake 4.3.0 against 4.5.0, or
# read in the v4.5.0 and v4.4.5 sources, the 4.5.0 parser:
#   - keeps the blanks right after "=" and before a "#" comment INSIDE
#     a variable's value, so "Libs: -L${libdir}" splits into a bare
#     "-L" plus loose path pieces (CI run 43357621563, "ZERO -L flags");
#   - no longer refuses, under STRICTNESS STRICT, a variable or a field
#     declared twice, nor a variable's "${name}" that no earlier line
#     declares (it substitutes an empty text);
#   - drops, silently, a line that is not a declaration (a name with a
#     "-" in it, say), where the 4.1-4.4 parser refused the whole file;
#   - keeps, as text, a "$" that starts no "${...}" reference, where the
#     4.1-4.4 parser refused the whole file (PACKAGING.md documents that
#     refusal);
#   - ends the value at an escaped "\#", where the 4.1-4.4 parser, FDO
#     pkg-config and pkgconf all keep a literal "#" (no spelling at all
#     gives the 4.5.0 parser a literal "#").
#
# GODS_LAWS.md L-04 (the same behavior on every supported system) is why
# the functions below exist. Before cmake_pkg_config() sees the scratch
# copy, they rewrite it, logical line by logical line, into the ONE form
# both parsers read the same way, and they refuse, themselves, what the
# 4.1-4.4 parser refused: the verdict they keep is the one CMake 4.1 to
# 4.4 gives. The line grammar is the one FDO pkg-config, pkgconf and
# both llpkgc versions share: optional blanks, a name of ASCII letters,
# digits, "_" and ".", optional blanks, then "=" (a variable) or ":" (a
# field). They never substitute "${...}", never split Cflags:/Libs: and
# never resolve a value: reading the file is still cmake_pkg_config()'s
# job (ESCOPO.md, decision 7).
#
# DECLARED, NOT HANDLED (TODO.md INBOX, CMAKE45-PC-FIX1): quotes and
# backslashes inside Cflags:/Libs: (4.5 splits them the way a shell
# does, 4.1-4.4 by blanks only - not measured); a value that ends in a
# backslash once its comment and blanks are gone; a field name repeated
# in another letter case; a "#", "$" or blank inside the real directory
# that replaces "${pcfiledir}".

# The grammar of a declaration line, kept in ONE place: CMAKE_MATCH_1 is
# the name, CMAKE_MATCH_2 the separator ("=" variable, ":" field) and
# CMAKE_MATCH_3 the raw value.
function(glintfx_pkgconfig_declaration_pattern out_var)
    set(${out_var} "^[ \t]*([A-Za-z0-9_.]+)[ \t]*([=:])(.*)$" PARENT_SCOPE)
endfunction()

# Every line ending becomes "\n": a CRLF pair, and a lone CR, which
# pkgconf and both llpkgc versions also end a line at.
function(glintfx_pkgconfig_normalize_line_endings text_var)
    string(REPLACE "\r\n" "\n" _glintfx_text "${${text_var}}")
    string(REPLACE "\r" "\n" _glintfx_text "${_glintfx_text}")
    set(${text_var} "${_glintfx_text}" PARENT_SCOPE)
endfunction()

# Takes ONE logical line off the front of rest_var: a physical line that
# ends in an unescaped backslash, outside a comment, goes on in the next
# physical line, the backslash and the line ending removed and nothing
# inserted - FDO pkg-config, pkgconf and both llpkgc versions join it
# the same way. A comment ends at its own physical line, as in llpkgc
# (pkgconf would let it run on). A backslash at the very end of the file
# is kept.
function(glintfx_pkgconfig_pop_logical_line rest_var out_line)
    set(_glintfx_rest "${${rest_var}}")
    set(_glintfx_line "")
    set(_glintfx_continued TRUE)
    while(_glintfx_continued)
        string(FIND "${_glintfx_rest}" "\n" _glintfx_newline_at)
        if(_glintfx_newline_at EQUAL -1)
            set(_glintfx_physical "${_glintfx_rest}")
            set(_glintfx_rest "")
        else()
            string(SUBSTRING "${_glintfx_rest}" 0 ${_glintfx_newline_at} _glintfx_physical)
            math(EXPR _glintfx_next_at "${_glintfx_newline_at} + 1")
            string(SUBSTRING "${_glintfx_rest}" ${_glintfx_next_at} -1 _glintfx_rest)
        endif()
        set(_glintfx_continued FALSE)
        if(_glintfx_physical MATCHES "^([^\\\\#]|\\\\.)*\\\\$" AND NOT _glintfx_rest STREQUAL "")
            string(REGEX REPLACE "\\\\$" "" _glintfx_physical "${_glintfx_physical}")
            set(_glintfx_continued TRUE)
        endif()
        string(APPEND _glintfx_line "${_glintfx_physical}")
    endwhile()
    set(${rest_var} "${_glintfx_rest}" PARENT_SCOPE)
    set(${out_line} "${_glintfx_line}" PARENT_SCOPE)
endfunction()

function(glintfx_pkgconfig_refuse_unrecognized_line pc_file line_var)
    message(FATAL_ERROR
        "glintfx: glintfx.pc has a line that is not a declaration, a "
        "comment or a blank line: '${${line_var}}' (pc file: "
        "'${pc_file}'). A declaration is a name made only of letters, "
        "digits, \"_\" and \".\", then \"=\" or \":\". CMake up to 4.4 "
        "refuses such a file as unparseable, CMake 4.5 drops the line "
        "silently and real pkgconf ignores it; glintfx refuses it on "
        "every CMake version. Skip this check with "
        "GLINTFX_SKIP_PKGCONFIG_VALIDATION=1 in the environment of this "
        "`cmake --install` invocation, then verify the install by hand."
    )
endfunction()

# A "$" may only start "${" or "$$" (a literal "$"): walked in pairs from
# the start, so "$${x}" is text and "$$$x" holds a lone "$".
function(glintfx_pkgconfig_refuse_lone_dollar pc_file name value_var)
    set(_glintfx_value "${${value_var}}")
    if(_glintfx_value MATCHES "^([^$]|\\$\\$|\\$\\{)*\\$([^{$]|$)")
        message(FATAL_ERROR
            "glintfx: glintfx.pc gives the declaration '${name}' a lone $ "
            "that starts no \${...} reference (pc file: '${pc_file}'). "
            "CMake up to 4.4 refuses such a file, CMake 4.5 keeps the $ "
            "as text; glintfx refuses it on every CMake version (write $$ "
            "for a literal $). Skip this check with "
            "GLINTFX_SKIP_PKGCONFIG_VALIDATION=1 in the environment of "
            "this `cmake --install` invocation, then verify the install "
            "by hand."
        )
    endif()
endfunction()

# Percent-encodes the two characters the 4.5.0 parser cannot carry the
# way the 4.1-4.4 one does: every "%" becomes "%25" FIRST, then every
# escaped "\#" becomes "%23". Both parsers read "%", digits and letters
# literally, so the value reaches cmake_pkg_config() intact on every
# version, and glintfx_pkgconfig_percent_decode() reverses it exactly
# (each "%" of the encoded text starts one of the two codes, so no
# packager's own text is ever mistaken for one). After the comment is
# gone, every "#" left in a value is escaped, so a plain string(REPLACE)
# of "\#" is exact.
function(glintfx_pkgconfig_percent_encode value_var)
    string(REPLACE "%" "%25" _glintfx_value "${${value_var}}")
    string(REPLACE "\\#" "%23" _glintfx_value "${_glintfx_value}")
    set(${value_var} "${_glintfx_value}" PARENT_SCOPE)
endfunction()

# Reverses glintfx_pkgconfig_percent_encode() in one list
# cmake_pkg_config() handed back: "%23" first, then "%25".
function(glintfx_pkgconfig_percent_decode list_var)
    string(REPLACE "%23" "#" _glintfx_decoded "${${list_var}}")
    string(REPLACE "%25" "%" _glintfx_decoded "${_glintfx_decoded}")
    set(${list_var} "${_glintfx_decoded}" PARENT_SCOPE)
endfunction()

# The value as both parsers must see it: its unescaped "#" comment
# dropped, its blanks trimmed on both sides (as pkg-config trims them),
# a lone "$" refused, then percent-encoded.
function(glintfx_pkgconfig_canonical_value pc_file name value_var)
    set(_glintfx_value "${${value_var}}")
    if(_glintfx_value MATCHES "^(([^\\\\#]|\\\\.)*)#")
        set(_glintfx_value "${CMAKE_MATCH_1}")
    endif()
    string(STRIP "${_glintfx_value}" _glintfx_value)
    glintfx_pkgconfig_refuse_lone_dollar("${pc_file}" "${name}" _glintfx_value)
    glintfx_pkgconfig_percent_encode(_glintfx_value)
    set(${value_var} "${_glintfx_value}" PARENT_SCOPE)
endfunction()

# A "${name}" in a VARIABLE's value must name a variable declared on an
# EARLIER line (never itself), or pc_sysrootdir, which CMake predefines:
# CMake 4.1-4.4 refuse the file otherwise, CMake 4.5 substitutes an
# empty text. A FIELD's reference to an undeclared variable is an empty
# text on every CMake version, so it is left alone. "$$" is a literal
# "$" and is dropped first, so "$${x}" names nothing.
function(glintfx_pkgconfig_refuse_undeclared_reference pc_file name value_var seen_var)
    string(REPLACE "$$" "" _glintfx_value "${${value_var}}")
    string(REGEX MATCHALL "\\$\\{[^}]*\\}" _glintfx_references "${_glintfx_value}")
    set(_glintfx_seen "${${seen_var}}")
    foreach(_glintfx_reference IN LISTS _glintfx_references)
        string(REGEX REPLACE "^\\$\\{(.*)\\}$" "\\1" _glintfx_referenced "${_glintfx_reference}")
        list(FIND _glintfx_seen "=${_glintfx_referenced}" _glintfx_found_at)
        if(_glintfx_found_at EQUAL -1 AND NOT _glintfx_referenced STREQUAL "pc_sysrootdir")
            message(FATAL_ERROR
                "glintfx: glintfx.pc gives the variable '${name}' a "
                "reference to '${_glintfx_referenced}', which no earlier "
                "line declares (pc file: '${pc_file}'). CMake up to 4.4 "
                "refuses such a file, CMake 4.5 substitutes an empty "
                "text; glintfx refuses it on every CMake version. Skip "
                "this check with GLINTFX_SKIP_PKGCONFIG_VALIDATION=1 in "
                "the environment of this `cmake --install` invocation, "
                "then verify the install by hand."
            )
        endif()
    endforeach()
endfunction()

# Claims a declaration's name in seen_var (entries "=<variable>" and
# ":<field>", two separate namespaces, as in pkg-config); a second claim
# of the same name is refused, in every spelling of the line.
function(glintfx_pkgconfig_claim_declaration_name pc_file separator name seen_var)
    set(_glintfx_seen "${${seen_var}}")
    list(FIND _glintfx_seen "${separator}${name}" _glintfx_found_at)
    if(NOT _glintfx_found_at EQUAL -1)
        set(_glintfx_kind "field")
        set(_glintfx_real_tool "real pkgconf joins the two occurrences")
        if(separator STREQUAL "=")
            set(_glintfx_kind "variable")
            set(_glintfx_real_tool "real pkgconf keeps only the last definition")
        endif()
        message(FATAL_ERROR
            "glintfx: glintfx.pc declares the ${_glintfx_kind} "
            "'${name}' more than once (pc file: '${pc_file}'). CMake up "
            "to 4.4 refuses such a file, CMake 4.5 accepts it silently "
            "and ${_glintfx_real_tool}; glintfx refuses the ambiguous file "
            "on every CMake version. Skip this check with "
            "GLINTFX_SKIP_PKGCONFIG_VALIDATION=1 in the environment of "
            "this `cmake --install` invocation, then verify the install "
            "by hand."
        )
    endif()
    list(APPEND _glintfx_seen "${separator}${name}")
    set(${seen_var} "${_glintfx_seen}" PARENT_SCOPE)
endfunction()

# Rewrites ONE declaration line as "name=value" (a variable) or
# "name: value" (a field). A variable's references are checked against
# the names declared BEFORE this line, and only then is its name
# claimed, so a variable never counts as declared inside its own value.
function(glintfx_pkgconfig_canonical_declaration pc_file line_var seen_var)
    glintfx_pkgconfig_declaration_pattern(_glintfx_pattern)
    string(REGEX MATCH "${_glintfx_pattern}" _glintfx_whole "${${line_var}}")
    set(_glintfx_name "${CMAKE_MATCH_1}")
    set(_glintfx_separator "${CMAKE_MATCH_2}")
    set(_glintfx_value "${CMAKE_MATCH_3}")
    set(_glintfx_seen "${${seen_var}}")
    glintfx_pkgconfig_canonical_value("${pc_file}" "${_glintfx_name}" _glintfx_value)
    set(_glintfx_line "${_glintfx_name}: ${_glintfx_value}")
    if(_glintfx_separator STREQUAL "=")
        glintfx_pkgconfig_refuse_undeclared_reference("${pc_file}" "${_glintfx_name}" _glintfx_value _glintfx_seen)
        set(_glintfx_line "${_glintfx_name}=${_glintfx_value}")
    endif()
    glintfx_pkgconfig_claim_declaration_name("${pc_file}" "${_glintfx_separator}" "${_glintfx_name}" _glintfx_seen)
    set(${line_var} "${_glintfx_line}" PARENT_SCOPE)
    set(${seen_var} "${_glintfx_seen}" PARENT_SCOPE)
endfunction()

# The whole stage, over the pcfiledir-substituted scratch text: every
# logical line comes out as a canonical declaration or as an empty line
# (a blank line, a comment), or the file is refused. The summary line it
# prints only when it finishes is what tells, in the output, that no
# refusal of its own fired.
function(glintfx_pkgconfig_canonicalize_declarations pc_file text_var)
    set(_glintfx_rest "${${text_var}}")
    glintfx_pkgconfig_normalize_line_endings(_glintfx_rest)
    glintfx_pkgconfig_declaration_pattern(_glintfx_pattern)
    set(_glintfx_out "")
    set(_glintfx_seen "")
    while(NOT _glintfx_rest STREQUAL "")
        glintfx_pkgconfig_pop_logical_line(_glintfx_rest _glintfx_line)
        if(_glintfx_line MATCHES "^[ \t]*$" OR _glintfx_line MATCHES "^[ \t]*#")
            set(_glintfx_line "")
        elseif(_glintfx_line MATCHES "${_glintfx_pattern}")
            glintfx_pkgconfig_canonical_declaration("${pc_file}" _glintfx_line _glintfx_seen)
        else()
            glintfx_pkgconfig_refuse_unrecognized_line("${pc_file}" _glintfx_line)
        endif()
        string(APPEND _glintfx_out "${_glintfx_line}\n")
    endwhile()

    list(LENGTH _glintfx_seen _glintfx_declaration_count)
    message(STATUS
        "glintfx: glintfx.pc canonicalized for CMake's native parser - "
        "${_glintfx_declaration_count} declaration(s), none repeated."
    )
    set(${text_var} "${_glintfx_out}" PARENT_SCOPE)
endfunction()

# Runs cmake_pkg_config(EXTRACT ...) on the canonical scratch copy and
# hands back its -I and -L token lists, percent-decoded.
function(glintfx_pkgconfig_extract_native_tokens native_input out_includes out_libdirs)
    cmake_pkg_config(EXTRACT "${native_input}" REQUIRED STRICTNESS STRICT)
    set(_glintfx_includes "${CMAKE_PKG_CONFIG_INCLUDES}")
    set(_glintfx_libdirs "${CMAKE_PKG_CONFIG_LIBDIRS}")
    glintfx_pkgconfig_percent_decode(_glintfx_includes)
    glintfx_pkgconfig_percent_decode(_glintfx_libdirs)
    set(${out_includes} "${_glintfx_includes}" PARENT_SCOPE)
    set(${out_libdirs} "${_glintfx_libdirs}" PARENT_SCOPE)
endfunction()

# ONE OF THE TWO HAND-WRITTEN TEXT OPERATIONS IN THIS FILE (see this
# file's own header, "STRICTNESS STRICT", for why it exists at all):
# copies pc_file's own text to a private scratch file under
# @GLINTFX_VALIDATE_SCRATCH_DIR@ (a build-tree location, never the
# packager's own install tree) and replaces every literal
# "${pcfiledir}" token with pc_file's own, already-absolute
# PARENT_PATH - a single, exact-substring string(REPLACE ...), not a
# parser: no "${...}" is evaluated - and then hands the text to
# glintfx_pkgconfig_canonicalize_declarations() (see its own comment)
# before writing it. cmake_pkg_config(EXTRACT ...) below resolves the
# result, natively.
#
# One scratch file per validation run is enough - this file's own
# install(CODE) registration runs this whole script exactly once per
# `cmake --install` invocation (glintfx_register_pkgconfig_validation(),
# cmake/GlintfxPkgConfigValidate.cmake) - so there is no concurrent-
# write hazard to guard against here.
function(glintfx_pkgconfig_prepare_native_input pc_file out_scratch_file)
    file(READ "${pc_file}" _glintfx_pc_text)
    cmake_path(GET pc_file PARENT_PATH _glintfx_pcfiledir)
    string(REPLACE "\${pcfiledir}" "${_glintfx_pcfiledir}" _glintfx_pc_text_substituted "${_glintfx_pc_text}")
    glintfx_pkgconfig_canonicalize_declarations("${pc_file}" _glintfx_pc_text_substituted)

    set(_glintfx_scratch_dir "@GLINTFX_VALIDATE_SCRATCH_DIR@")
    file(MAKE_DIRECTORY "${_glintfx_scratch_dir}")
    set(_glintfx_scratch_file "${_glintfx_scratch_dir}/glintfx.pc")
    file(WRITE "${_glintfx_scratch_file}" "${_glintfx_pc_text_substituted}")

    set(${out_scratch_file} "${_glintfx_scratch_file}" PARENT_SCOPE)
endfunction()

# Validates ONE "-I"/"-L"-token LIST (already extracted by
# cmake_pkg_config(EXTRACT ...) into CMAKE_PKG_CONFIG_INCLUDES or
# CMAKE_PKG_CONFIG_LIBDIRS - see glintfx_pkgconfig_validate_content_native()
# below) against real content on disk: every token strips its own
# "-I"/"-L" prefix and must resolve to a directory containing the
# expected content: a "glintfx/" subdirectory for headers, or one of
# glintfx_pkgconfig_library_glob_patterns() for the library artifact.
# flag_prefix is "-I" or "-L"; expected_content_kind is "headers" or
# "library" - the only two things any path glintfx.pc emits ever
# names, the same two shapes tests/tools/check_pkgconfig.sh's own
# assert_dir_contains_expected_content already checks in CI.
# GODS_LAWS.md L-40 floor: out_count is always set, even to zero - the
# CALLER decides whether zero is a failure, this function only counts
# and validates what it is given.
#
# ANCHORED TO pcfiledir, NEVER LEFT CWD-DEPENDENT - MEASURED, not
# assumed: a bare relative "-L"/"-I" token straight out of
# CMAKE_PKG_CONFIG_INCLUDES/LIBDIRS (no leading "/", the shape a
# tampered "libdir=some-relative-name" line - with no "${...}"
# reference at all - produces) is left EXACTLY as relative by
# cmake_pkg_config() itself; CMake's own IS_DIRECTORY on a relative
# path resolves it against CMAKE_CURRENT_SOURCE_DIR, which in script
# mode is the CALLER's CWD - reproduced live, twice, once from a
# directory holding a decoy "libglintfx.so*" under that same relative
# name (IS_DIRECTORY reported TRUE) and once from an unrelated empty
# directory (IS_DIRECTORY reported FALSE, same token, same file). This
# is the EXACT "biblioteca apagada, descritor com caminho relativo,
# comando disparado de dentro de uma pasta com uma biblioteca falsa"
# attack this whole validator exists to refuse - and it is a NEW
# finding, specific to routing token resolution through
# cmake_pkg_config() instead of the deleted hand-written reader (the
# old reader anchored to pcfiledir directly; the native command hands
# back a token that may still be bare-relative, and does not anchor it
# for us). Fixed the same way the old reader fixed it: every token is
# forced absolute against pc_file's OWN, already-absolute parent
# directory - never CMAKE_CURRENT_SOURCE_DIR, never anything a
# packager's invocation directory can influence - via
# glintfx_pkgconfig_force_absolute(), defined above.
function(glintfx_pkgconfig_validate_content_tokens pc_file tokens flag_prefix expected_content_kind out_count)
    cmake_path(GET pc_file PARENT_PATH _glintfx_tokens_pcfiledir)
    set(_glintfx_count 0)
    foreach(_glintfx_token IN LISTS tokens)
        if(NOT _glintfx_token MATCHES "^${flag_prefix}(.+)$")
            continue()
        endif()
        set(_glintfx_path "${CMAKE_MATCH_1}")
        glintfx_pkgconfig_force_absolute(_glintfx_path "${_glintfx_tokens_pcfiledir}")

        if(NOT IS_DIRECTORY "${_glintfx_path}")
            message(FATAL_ERROR
                "glintfx: glintfx.pc's own '${flag_prefix}' field emitted "
                "'${_glintfx_token}', which resolves to '${_glintfx_path}', "
                "which does not exist on disk (pc file: "
                "'${pc_file}'). Skip this check with "
                "GLINTFX_SKIP_PKGCONFIG_VALIDATION=1 in the environment "
                "of this `cmake --install` invocation, then verify the "
                "install by hand."
            )
        endif()

        if(expected_content_kind STREQUAL "headers")
            if(NOT IS_DIRECTORY "${_glintfx_path}/glintfx")
                message(FATAL_ERROR
                    "glintfx: glintfx.pc's own '${flag_prefix}' field "
                    "emitted '${_glintfx_token}', which resolves to "
                    "'${_glintfx_path}' - it exists, but has no "
                    "'glintfx/' subdirectory, so the installed public "
                    "headers are not there (pc file: '${pc_file}'). "
                    "Skip this check with "
                    "GLINTFX_SKIP_PKGCONFIG_VALIDATION=1 in the "
                    "environment of this `cmake --install` invocation, "
                    "then verify the install by hand."
                )
            endif()
        elseif(expected_content_kind STREQUAL "library")
            glintfx_pkgconfig_library_glob_patterns(_glintfx_lib_pattern_names)
            set(_glintfx_lib_glob_patterns "")
            foreach(_glintfx_lib_pattern_name IN LISTS _glintfx_lib_pattern_names)
                list(APPEND _glintfx_lib_glob_patterns "${_glintfx_path}/${_glintfx_lib_pattern_name}")
            endforeach()
            file(GLOB _glintfx_lib_matches ${_glintfx_lib_glob_patterns})
            if(_glintfx_lib_matches STREQUAL "")
                message(FATAL_ERROR
                    "glintfx: glintfx.pc's own '${flag_prefix}' field "
                    "emitted '${_glintfx_token}', which resolves to "
                    "'${_glintfx_path}' - it exists, but has none of "
                    "${_glintfx_lib_pattern_names}, so the installed "
                    "library artifact is not there (pc file: "
                    "'${pc_file}'). Skip this check with "
                    "GLINTFX_SKIP_PKGCONFIG_VALIDATION=1 in the "
                    "environment of this `cmake --install` invocation, "
                    "then verify the install by hand."
                )
            endif()
        else()
            message(FATAL_ERROR
                "glintfx: glintfx_pkgconfig_validate_content_tokens: "
                "unknown expected_content_kind '${expected_content_kind}' "
                "(internal error in glintfx's own install(CODE) "
                "validation - this is not something a packaging layout "
                "can trigger)."
            )
        endif()

        math(EXPR _glintfx_count "${_glintfx_count} + 1")
    endforeach()
    set(${out_count} "${_glintfx_count}" PARENT_SCOPE)
endfunction()

# Orchestrates the WHOLE content check (LAYER A) against ONE installed
# glintfx.pc, natively: prepares the pcfiledir-substituted scratch copy
# (glintfx_pkgconfig_prepare_native_input(), above, which also runs
# glintfx_pkgconfig_canonicalize_declarations()), hands it to
# cmake_pkg_config(EXTRACT ... STRICTNESS STRICT) - CMake's own native
# pkg-config format parser, no pkg-config binary involved (see this
# file's header, "Talking to the pkg-config BINARY itself") - and
# validates every "-I"/"-L" token it extracts against real content on
# disk. GODS_LAWS.md L-40 floor: a Cflags:/Libs: line with no "-I"/"-L"
# token at all makes cmake_pkg_config() return an EMPTY list, not an
# error (measured: CMAKE_PKG_CONFIG_INCLUDES/LIBDIRS both come back
# empty, with exit 0, against a real glintfx.pc with blank "Cflags:"/
# "Libs:" fields) - the explicit EQUAL 0 checks below are what turn
# that silent "nothing to report" into the FATAL_ERROR L-40 requires;
# cmake_pkg_config() itself does not do this for us. FATAL_ERROR on
# every platform, Windows included, unconditionally - this is the
# check that used to run only AFTER a pkg-config binary conversation
# had already succeeded (PKG-WIN-SCOPE's original finding, still true
# today, unrelated to PKG-NATIVE): glintfx_validate_installed_pkgconfig()
# below calls this BEFORE it ever tries to find or talk to a
# pkg-config binary, on purpose.
function(glintfx_pkgconfig_validate_content_on_disk pc_file)
    glintfx_pkgconfig_prepare_native_input("${pc_file}" _glintfx_native_input)

    glintfx_pkgconfig_extract_native_tokens("${_glintfx_native_input}" _glintfx_includes _glintfx_libdirs)

    glintfx_pkgconfig_validate_content_tokens(
        "${pc_file}" "${_glintfx_includes}" "-I" headers _glintfx_include_flag_count
    )
    glintfx_pkgconfig_validate_content_tokens(
        "${pc_file}" "${_glintfx_libdirs}" "-L" library _glintfx_library_flag_count
    )

    if(_glintfx_include_flag_count EQUAL 0)
        message(FATAL_ERROR
            "glintfx: glintfx.pc's own Cflags: field emitted ZERO -I "
            "flags (pc file: '${pc_file}') - an empty Cflags: line "
            "would make this validator scan nothing and still report "
            "success (GODS_LAWS.md L-40). Skip this check with "
            "GLINTFX_SKIP_PKGCONFIG_VALIDATION=1 in the environment of "
            "this `cmake --install` invocation, then verify the "
            "install by hand."
        )
    endif()
    if(_glintfx_library_flag_count EQUAL 0)
        message(FATAL_ERROR
            "glintfx: glintfx.pc's own Libs: field emitted ZERO -L "
            "flags (pc file: '${pc_file}') - an empty Libs: line would "
            "make this validator scan nothing and still report success "
            "(GODS_LAWS.md L-40). Skip this check with "
            "GLINTFX_SKIP_PKGCONFIG_VALIDATION=1 in the environment of "
            "this `cmake --install` invocation, then verify the "
            "install by hand."
        )
    endif()

    message(STATUS
        "glintfx: post-install pkg-config content check (CMake's own "
        "native pkg-config parser, cmake_pkg_config(EXTRACT ... "
        "STRICTNESS STRICT) - no pkg-config binary involved) - "
        "${_glintfx_include_flag_count} -I flag(s) and "
        "${_glintfx_library_flag_count} -L flag(s) all resolve to "
        "real, populated directories."
    )
endfunction()

# THE DIAGNOSTIC ATOM (PKG-WIN-VALIDATE-FATAL, decisao do lider,
# 09/09/2026): everything a packager we have never met (GODS_LAWS.md
# LEI ZERO - the base of glintfx's consumers is public and unknown)
# needs to diagnose, and dispute, a failed pkg-config CONVERSATION by
# hand, without re-running anything themselves: the binary path
# find_program() actually resolved, that SAME binary's own --version
# output (a second, independent probe - proves the binary can be
# launched at all, useful precisely when the FIRST probe, the --exists
# conversation this validation cares about, is what just failed), the
# PKG_CONFIG_PATH this script set, VERBATIM (never re-derived, never
# summarized), the exact command line that was run, its numeric exit
# result, its combined stdout+stderr, the resolved glintfx.pc path, and
# that file's own first lines (a packager can eyeball the content
# without opening a second file), and the two escape hatches this
# file's own header already documents in full (one name,
# GLINTFX_SKIP_PKGCONFIG_VALIDATION, two mechanisms: a CACHE option at
# CONFIGURE time, an ENVIRONMENT variable at INSTALL time). Called from
# BOTH honest outcomes that can follow a binary genuinely being found
# by find_program() (numeric-failure FATAL_ERROR, and launch-failure
# declared-skip WARNING, both below in glintfx_validate_installed_pkgconfig()) -
# never from the "tool not found on PATH at all" branch above it, which
# has no binary path, command, or exit code to report in the first
# place.
function(glintfx_pkgconfig_print_conversation_diagnosis pkgconfig_exe exists_command exists_result exists_combined_output pc_file)
    execute_process(
        COMMAND "${pkgconfig_exe}" --version
        RESULT_VARIABLE _glintfx_diag_version_result
        OUTPUT_VARIABLE _glintfx_diag_version_output
        ERROR_VARIABLE _glintfx_diag_version_error
        OUTPUT_STRIP_TRAILING_WHITESPACE
    )
    if(_glintfx_diag_version_result EQUAL 0)
        set(_glintfx_diag_version_text "${_glintfx_diag_version_output}")
    else()
        set(_glintfx_diag_version_text
            "('${pkgconfig_exe}' --version ALSO could not be run - "
            "result='${_glintfx_diag_version_result}', "
            "stderr='${_glintfx_diag_version_error}')"
        )
    endif()

    if(EXISTS "${pc_file}")
        file(STRINGS "${pc_file}" _glintfx_diag_pc_first_lines LIMIT_COUNT 10)
        list(JOIN _glintfx_diag_pc_first_lines "\n      " _glintfx_diag_pc_first_lines_joined)
    else()
        set(_glintfx_diag_pc_first_lines_joined "(file does not exist: '${pc_file}')")
    endif()

    string(REPLACE ";" " " _glintfx_diag_command_human "${exists_command}")

    message(STATUS
        "glintfx: pkg-config CONVERSATION diagnosis (for a packager we "
        "have never met, GODS_LAWS.md LEI ZERO, to reproduce or dispute "
        "this by hand):\n"
        "    binary path: ${pkgconfig_exe}\n"
        "    binary --version: ${_glintfx_diag_version_text}\n"
        "    PKG_CONFIG_PATH: $ENV{PKG_CONFIG_PATH}\n"
        "    command run: ${_glintfx_diag_command_human}\n"
        "    exit result: ${exists_result}\n"
        "    stdout+stderr: ${exists_combined_output}\n"
        "    glintfx.pc path: ${pc_file}\n"
        "    glintfx.pc first lines:\n      ${_glintfx_diag_pc_first_lines_joined}\n"
        "    escape hatches (same name, two mechanisms - see this "
        "file's own header): -DGLINTFX_SKIP_PKGCONFIG_VALIDATION=ON at "
        "CONFIGURE time (skips this whole validation for the build "
        "directory), or GLINTFX_SKIP_PKGCONFIG_VALIDATION=1 in the "
        "environment of this 'cmake --install' invocation (skips it "
        "for this one install only)."
    )
endfunction()

function(glintfx_validate_installed_pkgconfig)
    if(DEFINED ENV{GLINTFX_SKIP_PKGCONFIG_VALIDATION}
       AND NOT "$ENV{GLINTFX_SKIP_PKGCONFIG_VALIDATION}" STREQUAL ""
       AND NOT "$ENV{GLINTFX_SKIP_PKGCONFIG_VALIDATION}" STREQUAL "0")
        message(STATUS
            "glintfx: post-install pkg-config validation skipped - "
            "GLINTFX_SKIP_PKGCONFIG_VALIDATION is set in the "
            "environment of this `cmake --install` invocation."
        )
        return()
    endif()

    glintfx_pkgconfig_validate_resolve_staged_dir(_glintfx_pkgconfig_dir)
    set(_glintfx_pc_file "${_glintfx_pkgconfig_dir}/glintfx.pc")

    if(NOT EXISTS "${_glintfx_pc_file}")
        message(FATAL_ERROR
            "glintfx: expected to find glintfx.pc at "
            "'${_glintfx_pc_file}' right after installing it, and it "
            "is not there. This usually means CMAKE_INSTALL_LIBDIR, "
            "CMAKE_INSTALL_PREFIX or DESTDIR combined in a way this "
            "validation step did not anticipate. Skip this check with "
            "GLINTFX_SKIP_PKGCONFIG_VALIDATION=1 in the environment of "
            "this `cmake --install` invocation (or reconfigure with "
            "-DGLINTFX_SKIP_PKGCONFIG_VALIDATION=ON to disable it "
            "permanently for this build), then verify the install by "
            "hand."
        )
    endif()

    # LAYER A, unconditional, on EVERY platform, BEFORE this file ever
    # tries to find or talk to a pkg-config binary: CMake's own native
    # pkg-config parser confirms includedir/libdir and every -I/-L
    # token resolve to real, populated content on disk
    # (glintfx_pkgconfig_validate_content_on_disk(), defined above).
    glintfx_pkgconfig_validate_content_on_disk("${_glintfx_pc_file}")

    # PKG-WIN-INTEROP (measured live on a real Windows 11 VM, qemu
    # guest-agent channel, 08/09/2026): find_program()'s own documented
    # Windows suffix order is ".com", ".exe", then no suffix at all -
    # it NEVER tries ".bat" (CMake's find_program.html: "On Windows,
    # filename suffixes are considered in order .com, .exe, and no
    # suffix"). Strawberry Perl's pkg-config distribution ships TWO
    # files named "pkg-config" in the same directory: a bare,
    # extension-less Perl script (not a valid Win32 executable on its
    # own - no PE header, just "#!perl" text) and "pkg-config.bat" (the
    # pl2bat-generated wrapper that actually runs). With a single NAME
    # "pkg-config", find_program's third suffix attempt ("no suffix")
    # matches the bare script FIRST, before ".bat" is ever considered.
    # execute_process() below then tries to launch that bare text file
    # directly (no shell involved - the same direct-CreateProcess path
    # CMake's own KWSys process launcher uses), and Win32 refuses:
    # measured literally, by reproducing the identical launch
    # (System.Diagnostics.Process, UseShellExecute=$false) against that
    # same file on the real machine -
    #   "O executavel especificado nao e um aplicativo valido para
    #   esta plataforma de SO."
    # (the pt-BR text of "%1 is not a valid Win32 application",
    # ERROR_BAD_EXE_FORMAT) - a LAUNCH failure in the PARENT, before
    # any child process exists. That is exactly why the warning below
    # used to report an EMPTY error message: there was never a child
    # process to write one, so ERROR_VARIABLE had nothing to capture -
    # not a case of this file discarding real output.
    #
    # Same defect class CMake's own FindPkgConfig.cmake had and fixed
    # (GitLab cmake/cmake#21239, "FindPkgConfig not found with empty
    # reason when strawberry perl is in PATH on Windows", MR!9375
    # preferring the .bat name on Windows) - never applied to this
    # file's own, independent find_program() call until now. WIN32
    # only: NAMES are tried in the order given, and find_program's own
    # suffix search resolves "pkg-config.bat"'s bare-suffix candidate
    # (the literal file "pkg-config.bat") before this search ever
    # reaches the plain "pkg-config"/"pkgconf" names later in the
    # list - so a real wrapper on PATH is always preferred over a bare
    # script sharing its base name, and the fallback to the plain
    # names is what still finds a pkgconf/pkg-config that genuinely
    # has no ".bat" (a native pkgconf.exe, for instance).
    if(WIN32)
        find_program(GLINTFX_PKGCONFIG_VALIDATE_EXE
            NAMES pkg-config.bat pkgconf.bat pkg-config pkgconf
            NO_CACHE
        )
    else()
        find_program(GLINTFX_PKGCONFIG_VALIDATE_EXE NAMES pkg-config pkgconf NO_CACHE)
    endif()
    if(NOT GLINTFX_PKGCONFIG_VALIDATE_EXE)
        message(WARNING
            "glintfx: pkg-config (and pkgconf) not found on PATH - "
            "skipping the pkg-config BINARY conversation "
            "('pkg-config --exists glintfx'). glintfx.pc was written "
            "to '${_glintfx_pc_file}', and its content already passed "
            "this file's own native content check (includedir, libdir, "
            "and every -I/-L token confirmed against real content on "
            "disk by CMake's own pkg-config parser); there is simply "
            "no pkg-config/pkgconf on PATH to additionally confirm a "
            "REAL pkg-config binary also resolves it. Install "
            "pkg-config (or pkgconf) to get that extra confirmation, "
            "or set GLINTFX_SKIP_PKGCONFIG_VALIDATION=1 to silence "
            "this warning intentionally."
        )
        return()
    endif()

    # Unchanged by PKG-NATIVE - this half never used the hand-written
    # reader, and is not what the lider's decision replaced. See this
    # file's own header, "Talking to the pkg-config BINARY itself".
    if(WIN32)
        cmake_path(CONVERT "${_glintfx_pkgconfig_dir}" TO_NATIVE_PATH_LIST _glintfx_pkgconfig_path_native)
        string(APPEND _glintfx_pkgconfig_path_native ";")
        set(ENV{PKG_CONFIG_PATH} "${_glintfx_pkgconfig_path_native}")
    else()
        set(ENV{PKG_CONFIG_PATH} "${_glintfx_pkgconfig_dir}")
    endif()

    set(_glintfx_exists_command
        "${GLINTFX_PKGCONFIG_VALIDATE_EXE}" --print-errors --exists glintfx
    )
    execute_process(
        COMMAND ${_glintfx_exists_command}
        RESULT_VARIABLE _glintfx_exists_result
        OUTPUT_VARIABLE _glintfx_exists_output
        ERROR_VARIABLE _glintfx_exists_error
    )
    set(_glintfx_exists_combined_output "${_glintfx_exists_output}${_glintfx_exists_error}")

    if(NOT _glintfx_exists_result MATCHES "^-?[0-9]+$")
        # PKG-WIN-VALIDATE-FATAL (decisao do lider, 09/09/2026): a
        # RESULT_VARIABLE that is not a plain integer means
        # execute_process() could not even START the child process -
        # CMake's own execute_process() documentation: "an integer
        # return code from the last child process, or a string
        # describing an error condition if the child process(es) could
        # not be run". This is the exact ERROR_BAD_EXE_FORMAT class
        # PKG-WIN-INTEROP already measured live (a bare, unlaunchable
        # script sharing pkg-config's own base name, matched by
        # find_program()'s "no suffix" fallback before ".bat" is ever
        # tried) - a LAUNCH failure in the PARENT, never a real
        # conversation with a broken/incompatible pkg-config: there was
        # no conversation to have at all. Anti false-positive
        # (GODS_LAWS.md L-27): this stays a DECLARED SKIP, never fatal,
        # never silent - this file's own content check (LAYER A, above)
        # already confirmed the installed content is genuinely good;
        # only THIS binary's ability to be launched at all is
        # unverified.
        glintfx_pkgconfig_print_conversation_diagnosis(
            "${GLINTFX_PKGCONFIG_VALIDATE_EXE}" "${_glintfx_exists_command}"
            "${_glintfx_exists_result}" "${_glintfx_exists_combined_output}"
            "${_glintfx_pc_file}"
        )
        message(WARNING
            "glintfx: post-install pkg-config CONVERSATION SKIPPED "
            "(declared, not verified) on this Windows machine - the "
            "pkg-config binary find_program() resolved "
            "('${GLINTFX_PKGCONFIG_VALIDATE_EXE}') could not even be "
            "LAUNCHED (RESULT_VARIABLE='${_glintfx_exists_result}', not "
            "a numeric exit code) - see the diagnosis printed above for "
            "everything needed to reproduce this by hand. This file's "
            "OWN native content check already ran before this point "
            "(CMake's own pkg-config parser, no pkg-config binary "
            "involved) and already confirmed glintfx.pc, the headers "
            "and the library artifact are genuinely on disk with real "
            "content; only whether THIS machine's pkg-config binary can "
            "even be started is unverified. Set "
            "GLINTFX_SKIP_PKGCONFIG_VALIDATION=1 to silence this "
            "warning intentionally, or verify by hand with the "
            "pkg-config on this machine."
        )
        return()
    endif()

    if(NOT _glintfx_exists_result EQUAL 0)
        if(WIN32)
            # Decisao do lider, 09/09/2026 (fecha o "aviso, decisao
            # pendente" do commit 9304585): the binary WAS found AND
            # genuinely LAUNCHED (a real, numeric exit result - the
            # branch immediately above already ruled out a launch
            # failure) and it REJECTED glintfx.pc. This is a real,
            # reproducible failure of the exact conversation this
            # validation exists to prove, not a platform quirk this
            # file cannot enumerate - so it is FATAL_ERROR here too,
            # exactly like every other platform, never silently
            # downgraded to a warning just because the host happens to
            # be Windows. The diagnosis atom gives a packager we have
            # never met everything needed to reproduce or dispute this
            # by hand (GODS_LAWS.md LEI ZERO).
            glintfx_pkgconfig_print_conversation_diagnosis(
                "${GLINTFX_PKGCONFIG_VALIDATE_EXE}" "${_glintfx_exists_command}"
                "${_glintfx_exists_result}" "${_glintfx_exists_combined_output}"
                "${_glintfx_pc_file}"
            )
            message(FATAL_ERROR
                "glintfx: 'pkg-config --exists glintfx' failed against "
                "the file just installed at '${_glintfx_pc_file}' "
                "(PKG_CONFIG_PATH=$ENV{PKG_CONFIG_PATH}, exit result "
                "${_glintfx_exists_result}): ${_glintfx_exists_error}. "
                "This file's OWN native content check already ran "
                "before this point and already confirmed glintfx.pc, "
                "the headers and the library artifact are genuinely on "
                "disk with real content - a real, genuinely LAUNCHED "
                "pkg-config binary on this machine still refuses to "
                "resolve it, which is a genuine defect (in the "
                "installed glintfx.pc, or in this machine's "
                "PKG_CONFIG_PATH/environment), not something to "
                "downgrade to a warning. Skip this check with "
                "GLINTFX_SKIP_PKGCONFIG_VALIDATION=1 in the environment "
                "of this `cmake --install` invocation, then verify the "
                "install by hand."
            )
        endif()
        message(FATAL_ERROR
            "glintfx: 'pkg-config --exists glintfx' failed against "
            "the file just installed at '${_glintfx_pc_file}' "
            "(PKG_CONFIG_PATH=${_glintfx_pkgconfig_dir}): "
            "${_glintfx_exists_error}. Skip this check with "
            "GLINTFX_SKIP_PKGCONFIG_VALIDATION=1 in the environment of "
            "this `cmake --install` invocation, then verify the "
            "install by hand."
        )
    endif()

    message(STATUS
        "glintfx: post-install pkg-config validation passed - "
        "glintfx.pc at '${_glintfx_pc_file}' passed this file's own "
        "native content check, and a real pkg-config binary on this "
        "machine's PATH also finds it via PKG_CONFIG_PATH."
    )
endfunction()

# PKG-WIN-SCOPE round 7's own regression net for
# glintfx_pkgconfig_looks_rooted() (defined above,
# glintfx_pkgconfig_force_absolute()'s own header): a fixed table of
# (value, expected classification) pairs, covering every SHAPE this
# fix's whole premise rests on - a driveless POSIX-rooted value (the
# exact one that reproduced the FATAL_ERROR this round exists to fix),
# a Windows drive-letter value (forward- and back-slashed), a UNC path,
# and a genuinely relative token (the one case that still needs
# base_directory anchoring, unchanged) - run through cmake -P
# UNCONDITIONALLY as pure string logic, so it classifies every one of
# them identically on THIS (or any) machine regardless of which
# platform the calling cmake binary itself was built for (this
# function's own comment explains why that portability is the entire
# point). Gated behind its own environment variable, mirroring this
# project's OWN established pattern for a test-only forced branch
# (tests/tools/check_dep_zero.py's
# GLINTFX_DEPZERO_SELFTEST_FORCE_WINDOWS_NEEDED_SKIP,
# check_public_name_collision.py's
# GLINTFX_PNC_SELFTEST_FORCE_GCC_FRONTEND_UNAVAILABLE-shaped forced
# branches) - never read by a real `cmake --install`, only by
# tests/tools/check_pkgconfig_validate.py's own selftest scenario.
function(glintfx_pkgconfig_selftest_looks_rooted)
    set(_glintfx_selftest_cases
        "/usr" TRUE
        "/usr/local/lib64" TRUE
        "D:/usr" TRUE
        "C:\\stage\\lib" TRUE
        "\\\\server\\share" TRUE
        "usr" FALSE
        "./stage" FALSE
        "relative-token" FALSE
        "decoy-relative-libdir" FALSE
    )
    list(LENGTH _glintfx_selftest_cases _glintfx_selftest_case_count)
    math(EXPR _glintfx_selftest_pair_count "${_glintfx_selftest_case_count} / 2")
    set(_glintfx_selftest_checked 0)
    set(_glintfx_selftest_index 0)
    while(_glintfx_selftest_index LESS _glintfx_selftest_case_count)
        list(GET _glintfx_selftest_cases ${_glintfx_selftest_index} _glintfx_selftest_value)
        math(EXPR _glintfx_selftest_expected_index "${_glintfx_selftest_index} + 1")
        list(GET _glintfx_selftest_cases ${_glintfx_selftest_expected_index} _glintfx_selftest_expected)

        glintfx_pkgconfig_looks_rooted("${_glintfx_selftest_value}" _glintfx_selftest_actual)
        if(NOT _glintfx_selftest_actual STREQUAL _glintfx_selftest_expected)
            message(FATAL_ERROR
                "glintfx: looks_rooted selftest FAILED - value "
                "'${_glintfx_selftest_value}' classified as "
                "'${_glintfx_selftest_actual}', expected "
                "'${_glintfx_selftest_expected}' (PKG-WIN-SCOPE round 7 "
                "regression: glintfx_pkgconfig_looks_rooted() must "
                "recognize a driveless POSIX-rooted value, a Windows "
                "drive-letter value in either slash direction, and a "
                "UNC path as already-rooted, while still requiring "
                "anchoring for a genuinely relative token)."
            )
        endif()
        math(EXPR _glintfx_selftest_checked "${_glintfx_selftest_checked} + 1")
        math(EXPR _glintfx_selftest_index "${_glintfx_selftest_index} + 2")
    endwhile()

    if(NOT _glintfx_selftest_checked EQUAL _glintfx_selftest_pair_count)
        message(FATAL_ERROR
            "glintfx: looks_rooted selftest internal error - checked "
            "${_glintfx_selftest_checked} of ${_glintfx_selftest_pair_count} "
            "declared cases (GODS_LAWS.md L-40: a selftest that silently "
            "skips cases is not a selftest)."
        )
    endif()

    message(STATUS
        "glintfx: looks_rooted selftest OK - "
        "${_glintfx_selftest_checked}/${_glintfx_selftest_pair_count} "
        "inputs classified correctly (driveless-rooted, drive-lettered "
        "both slash directions, UNC, and genuinely-relative forms all "
        "covered)."
    )
endfunction()

if(DEFINED ENV{GLINTFX_PKGVALIDATE_SELFTEST_LOOKS_ROOTED}
   AND NOT "$ENV{GLINTFX_PKGVALIDATE_SELFTEST_LOOKS_ROOTED}" STREQUAL "")
    glintfx_pkgconfig_selftest_looks_rooted()
else()
    glintfx_validate_installed_pkgconfig()
endif()
