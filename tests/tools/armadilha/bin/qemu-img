#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Armadilha de qemu-img (D-A27, L-09/L-50). Os selftests do win-vm-lab criam imagens
# minusculas em /var/tmp/glintfx-*-selftest.*: SO' quando todo caminho absoluto dos
# argumentos esta sob um diretorio assim, o qemu-img REAL (o proximo no PATH) roda.
# Qualquer outro caminho (o disco do laboratorio, por exemplo) registra e sai 97.
aqui="$(cd "$(dirname "$0")" && pwd)"
permitido=1
for arg in "$@"; do
  case "$arg" in
    /var/tmp/glintfx-*-selftest.*/*) ;;
    /*) permitido=0 ;;
  esac
done
if [ "$permitido" -eq 1 ]; then
  resto="$(printf '%s' "$PATH" | sed "s#${aqui}:##g")"
  real="$(PATH="$resto" command -v qemu-img)" || real=""
  [ -n "$real" ] && exec "$real" "$@"
fi
exec "$aqui/../registrar.sh" qemu-img "$@"
