#!/usr/bin/env sh
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# tools/git-hooks/pre-commit - thin caller, zero logic of its own
# (GODS_LAWS.md L-17: single subject). Installed by
# tools/git-hooks/install.sh into $(git rev-parse --git-common-dir)/hooks/,
# which is NOT versioned by git itself - this file IS the versioned
# source of truth, and install.sh is how it reaches the live hook.
#
# On this machine, core.hooksPath is a GLOBAL shim
# (~/.claude/githooks/pre-commit) that `exec`s a LOCAL
# .git/hooks/pre-commit if one exists and is executable, preserving
# args/stdin/exit code - so installing THIS file there bites without
# touching the global chain (todo_sync/tab_pendencias keep working). A
# clone with no such global chain still gets the ordinary git default:
# .git/hooks/pre-commit runs directly.
#
# GODS_LAWS.md L-07/D1 (leader, 28/08/2026, AskUserQuestion): the
# dependency-zero gate bites in BOTH commit and CI - this is the commit
# half. D3: no environment-variable escape - straight into the gate, no
# flag this script could honor to skip it.
#
# DEPZERO-GATE-PY (GODS_LAWS.md L-04, decisao do lider: "O
# comportamento deve ser igual em qualquer OS"): the gate itself is
# now tests/tools/check_dep_zero.py (ported from the former POSIX sh
# check_dep_zero.sh - see that Python file's own header). This wrapper
# stays POSIX sh on purpose: Git for Windows ships its own sh.exe and
# runs a hook by its shebang exactly like the four POSIX targets do,
# so this thin caller needs no port of its own - only the interpreter
# name search below (`python3` on the four POSIX targets, `python` on
# a stock Windows install whose default Python does not necessarily
# expose a `python3` alias), the same two names tests/CMakeLists.txt's
# own find_program(...NAMES python3 python REQUIRED) already searches.
#
# INBOX (drenagem de 06/09/2026, "nenhum portao de arquivo esta armado
# neste clone"): the second gate below, tests/tools/check_spdx.py
# (SPDX-GATE, GODS_LAWS.md L-08 - the repo is public under AGPL-3.0,
# and a file born without its header weakens the license), used to run
# ONLY in CI. Measured consequence: seven files landed in a commit
# without an SPDX header and the red only ever showed up later, on the
# server, because THIS hook itself had never been installed in this
# clone in the first place (`.git/hooks/pre-commit` did not exist -
# install.sh below had never been run here). check_spdx.py takes no
# `--staged` mode (it does not need one - its own enumeration already
# covers `git ls-files` plus `git ls-files --others --exclude-standard`,
# the closed-by-construction universe its own header documents, which
# already contains every file about to be committed).
#
# Sequential, not `&&`/`||` (L-45: a compound exit code hides WHICH gate
# reproved) - `set -e` below aborts this script with the failing gate's
# own exit code the moment any "$python_bin" invocation returns
# nonzero, and the next gate's own name never even gets a chance to
# print if an earlier one already failed.
#
# DASH-PUBDOC (docs/decisoes-inbox-tres.md SS3, GODS_LAWS.md L-32): a
# third gate, tests/tools/check_dash_pubdoc.py, closes the same "only
# ran on the server, or only in this one clone" gap SPDX-GATE above
# closed for the license header - the long dash (em dash, U+2014) this
# project's own CLAUDE.md forbids in documentation written for the
# external consumer was reaching commits because the ONLY mechanism
# that enforced it lived outside this repository entirely (global
# hooks that never classify `docs/*.md` as public, and never run on
# the server). Same take-no-flag-to-skip-it shape as the two gates
# above.

set -eu

repo_root="$(git rev-parse --show-toplevel)"

if command -v python3 >/dev/null 2>&1; then
    python_bin="python3"
elif command -v python >/dev/null 2>&1; then
    python_bin="python"
else
    echo "tools/git-hooks/pre-commit: neither 'python3' nor 'python' found in PATH (GODS_LAWS.md L-07 gate cannot run - no silent skip)" >&2
    exit 1
fi

"$python_bin" "$repo_root/tests/tools/check_dep_zero.py" --staged "$repo_root"
"$python_bin" "$repo_root/tests/tools/check_spdx.py" "$repo_root"
exec "$python_bin" "$repo_root/tests/tools/check_dash_pubdoc.py" "$repo_root"
