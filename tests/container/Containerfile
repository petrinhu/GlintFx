# SPDX-License-Identifier: AGPL-3.0-or-later
#
# tests/container/Containerfile - isolated Wayland compositor for any
# test that touches the leader's surface: keyboard, mouse or screen
# (GODS_LAWS.md L-09, TEST-WLCONT). The container is the outer
# boundary; the compositor lives INSIDE it, on a socket the host never
# shares. Nothing in this image, and nothing in the `docker run`
# invocation that starts it, may reach back into the host session -
# see check_isolation.sh for the proof.
#
# Pinned on fedora:44, the primary target (GODS_LAWS.md L-04): this
# gate has to fail exactly when the leader's own machine would fail,
# never drift to a moving `:latest`.
#
# kwin is the compositor by the leader's own registered decision
# (CLAUDE.md, "Isolamento obrigatório de teste"; GODS_LAWS.md L-09) -
# not weston, not sway, not labwc, and never an X11 framebuffer server
# (GODS_LAWS.md L-05: the prohibited term itself is spelled out in
# GODS_LAWS.md and in tests/tools/check_no_x11.sh's own pattern, never
# here - this comment would fail its own gate otherwise, see L-40).
# `--virtual` renders to a software framebuffer,
# which is why mesa-dri-drivers (llvmpipe) is here and /dev/dri is
# not: L-09 rule 4 says no real GPU device by default, precisely so
# this image renders the same way on every runner in the CI matrix.
#
# ARCH-PORTS, TDD case R4: a SECOND, throwaway build stage compiles
# connect_smoke.cpp against the REAL wayland_display_adapter/err.cpp/
# err_code.cpp production sources - staged here by
# prepare_arch_ports_fixture.sh (run BEFORE `docker build`, see
# .github/workflows/ci.yml's own "wayland-container" job, and that
# script's own header comment for why the docker build CONTEXT stays
# tests/container/, never the repository root). Two stages, not one:
# gcc-c++/wayland-devel never need to exist in the FINAL image this
# project runs the compositor from - only the resulting static-linked
# binary does, kept lean the same way a multi-stage container build
# normally trims a toolchain out of a runtime image.
#
# WL-DISPLAY fatia B, TDD case B: registry_smoke.cpp is built in this
# SAME stage, against the SAME staged sources (now also global_
# catalog.hpp/.cpp - see prepare_arch_ports_fixture.sh's own header
# comment) - one extra `g++` invocation, same flags, same fixture.
#
# WL-DISPLAY fatia C, TDD case C: fatal_error_smoke.cpp, same shape
# again - `-pthread` added because it uses std::this_thread::sleep_for
# (glibc's own libstdc++ threading facilities need it linked even for
# the non-thread-creating half of <thread>).
#
# WL-DISPLAY fatia D, TDD case D: pump_smoke.cpp, same shape again.
#
# WL-WINDOW fatia W-B (docs/plano-w6a-janela.md fatia 5): shell_smoke.cpp,
# same staged-sources shape again, plus wayland-protocols-devel (the
# xdg-shell.xml this stage's own wayland-scanner invocation below turns
# into a client header + private-code .c, the SAME two-artifact split
# cmake/GlintfxWaylandProtocols.cmake performs for the real library
# build - GODS_LAWS.md L-07: read from the SYSTEM package, never
# vendored).
#
# WL-WINDOW fatia W-E (docs/plano-w6a-janela.md fatia 8): window_smoke.cpp,
# same staged-sources shape again, plus window_adapter.cpp/window_
# configure_sequence.cpp (src/platform/wayland/) and the three OS-
# agnostic src/platform/window/ files (window_state.cpp, window_desc_
# validation.cpp, utf8_validation.cpp) - the ONE fixture in this whole
# image that goes on to attach a real wl_shm buffer and commit it
# (D-W5-9), which is what turns a REMOVED ack_configure() inside
# wayland_window_adapter into an actual protocol error instead of a
# silent no-op (this fixture's own header comment).
#
# WL-SEAT fatia S-B (docs/plano-w6a-janela.md fatia 12): seat_test.cpp,
# same staged-sources shape again, plus seat_adapter.cpp (src/platform/
# wayland/) and the OS-agnostic seat_capabilities.cpp (src/platform/
# input/) it writes into. Needs no xdg-shell binding at all - wl_seat
# is bound straight off the registry the same way wl_compositor/xdg_
# wm_base are, but this fixture never touches xdg_surface/xdg_toplevel.
FROM fedora:44 AS arch-ports-builder
RUN dnf -y install gcc-c++ pkgconf-pkg-config wayland-devel wayland-protocols-devel && dnf clean all
COPY _arch_ports_src /build/_arch_ports_src
COPY connect_smoke.cpp /build/connect_smoke.cpp
COPY registry_smoke.cpp /build/registry_smoke.cpp
COPY fatal_error_smoke.cpp /build/fatal_error_smoke.cpp
COPY pump_smoke.cpp /build/pump_smoke.cpp
COPY shell_smoke.cpp /build/shell_smoke.cpp
COPY window_smoke.cpp /build/window_smoke.cpp
COPY seat_test.cpp /build/seat_test.cpp
RUN wayland-scanner client-header \
        "$(pkg-config --variable=pkgdatadir wayland-protocols)/stable/xdg-shell/xdg-shell.xml" \
        /build/xdg-shell-client-protocol.h \
    && wayland-scanner private-code \
        "$(pkg-config --variable=pkgdatadir wayland-protocols)/stable/xdg-shell/xdg-shell.xml" \
        /build/xdg-shell-protocol.c \
    && gcc -O2 -Wall -Wextra -Werror $(pkg-config --cflags wayland-client) \
        -c /build/xdg-shell-protocol.c -o /build/xdg-shell-protocol.o
RUN g++ -std=c++23 -O2 -Wall -Wextra -Werror \
        -I /build/_arch_ports_src/include -I /build/_arch_ports_src/src \
        $(pkg-config --cflags wayland-client) \
        -o /build/arch_ports_connect_smoke \
        /build/_arch_ports_src/src/platform/wayland/display_adapter.cpp \
        /build/_arch_ports_src/src/platform/wayland/global_catalog.cpp \
        /build/_arch_ports_src/src/core/err.cpp \
        /build/_arch_ports_src/src/core/err_code.cpp \
        /build/connect_smoke.cpp \
        $(pkg-config --libs wayland-client) \
    && g++ -std=c++23 -O2 -Wall -Wextra -Werror \
        -I /build/_arch_ports_src/include -I /build/_arch_ports_src/src \
        $(pkg-config --cflags wayland-client) \
        -o /build/registry_smoke \
        /build/_arch_ports_src/src/platform/wayland/display_adapter.cpp \
        /build/_arch_ports_src/src/platform/wayland/global_catalog.cpp \
        /build/_arch_ports_src/src/core/err.cpp \
        /build/_arch_ports_src/src/core/err_code.cpp \
        /build/registry_smoke.cpp \
        $(pkg-config --libs wayland-client) \
    && g++ -std=c++23 -O2 -Wall -Wextra -Werror -pthread \
        -I /build/_arch_ports_src/include -I /build/_arch_ports_src/src \
        $(pkg-config --cflags wayland-client) \
        -o /build/fatal_error_smoke \
        /build/_arch_ports_src/src/platform/wayland/display_adapter.cpp \
        /build/_arch_ports_src/src/platform/wayland/global_catalog.cpp \
        /build/_arch_ports_src/src/core/err.cpp \
        /build/_arch_ports_src/src/core/err_code.cpp \
        /build/fatal_error_smoke.cpp \
        $(pkg-config --libs wayland-client) \
    && g++ -std=c++23 -O2 -Wall -Wextra -Werror \
        -I /build/_arch_ports_src/include -I /build/_arch_ports_src/src \
        $(pkg-config --cflags wayland-client) \
        -o /build/pump_smoke \
        /build/_arch_ports_src/src/platform/wayland/display_adapter.cpp \
        /build/_arch_ports_src/src/platform/wayland/global_catalog.cpp \
        /build/_arch_ports_src/src/core/err.cpp \
        /build/_arch_ports_src/src/core/err_code.cpp \
        /build/pump_smoke.cpp \
        $(pkg-config --libs wayland-client) \
    && g++ -std=c++23 -O2 -Wall -Wextra -Werror \
        -I /build/_arch_ports_src/include -I /build/_arch_ports_src/src -I /build \
        $(pkg-config --cflags wayland-client) \
        -o /build/shell_smoke \
        /build/_arch_ports_src/src/platform/wayland/display_adapter.cpp \
        /build/_arch_ports_src/src/platform/wayland/global_catalog.cpp \
        /build/_arch_ports_src/src/platform/wayland/shell_requirements.cpp \
        /build/_arch_ports_src/src/platform/wayland/shell_adapter.cpp \
        /build/_arch_ports_src/src/core/err.cpp \
        /build/_arch_ports_src/src/core/err_code.cpp \
        /build/xdg-shell-protocol.o \
        /build/shell_smoke.cpp \
        $(pkg-config --libs wayland-client) \
    && g++ -std=c++23 -O2 -Wall -Wextra -Werror \
        -I /build/_arch_ports_src/include -I /build/_arch_ports_src/src -I /build \
        $(pkg-config --cflags wayland-client) \
        -o /build/window_smoke \
        /build/_arch_ports_src/src/platform/wayland/display_adapter.cpp \
        /build/_arch_ports_src/src/platform/wayland/global_catalog.cpp \
        /build/_arch_ports_src/src/platform/wayland/shell_requirements.cpp \
        /build/_arch_ports_src/src/platform/wayland/shell_adapter.cpp \
        /build/_arch_ports_src/src/platform/wayland/window_configure_sequence.cpp \
        /build/_arch_ports_src/src/platform/window/window_state.cpp \
        /build/_arch_ports_src/src/platform/window/window_desc_validation.cpp \
        /build/_arch_ports_src/src/platform/window/utf8_validation.cpp \
        /build/_arch_ports_src/src/platform/wayland/window_adapter.cpp \
        /build/_arch_ports_src/src/core/err.cpp \
        /build/_arch_ports_src/src/core/err_code.cpp \
        /build/xdg-shell-protocol.o \
        /build/window_smoke.cpp \
        $(pkg-config --libs wayland-client) \
    && g++ -std=c++23 -O2 -Wall -Wextra -Werror \
        -I /build/_arch_ports_src/include -I /build/_arch_ports_src/src \
        $(pkg-config --cflags wayland-client) \
        -o /build/seat_test \
        /build/_arch_ports_src/src/platform/wayland/display_adapter.cpp \
        /build/_arch_ports_src/src/platform/wayland/global_catalog.cpp \
        /build/_arch_ports_src/src/platform/wayland/seat_adapter.cpp \
        /build/_arch_ports_src/src/platform/input/seat_capabilities.cpp \
        /build/_arch_ports_src/src/core/err.cpp \
        /build/_arch_ports_src/src/core/err_code.cpp \
        /build/seat_test.cpp \
        $(pkg-config --libs wayland-client)

FROM fedora:44

RUN dnf -y install \
        kwin \
        mesa-dri-drivers \
        mesa-libEGL \
        mesa-libgbm \
        dbus-daemon \
        wayland-utils \
        iproute \
        lsof \
        procps-ng \
        libstdc++ \
    && dnf clean all

COPY run_compositor.sh /usr/local/bin/run_compositor.sh
COPY smoke.sh /usr/local/bin/smoke.sh
COPY --from=arch-ports-builder /build/arch_ports_connect_smoke /usr/local/bin/arch_ports_connect_smoke
COPY --from=arch-ports-builder /build/registry_smoke /usr/local/bin/registry_smoke
COPY --from=arch-ports-builder /build/fatal_error_smoke /usr/local/bin/fatal_error_smoke
COPY --from=arch-ports-builder /build/pump_smoke /usr/local/bin/pump_smoke
COPY --from=arch-ports-builder /build/shell_smoke /usr/local/bin/shell_smoke
COPY --from=arch-ports-builder /build/window_smoke /usr/local/bin/window_smoke
COPY --from=arch-ports-builder /build/seat_test /usr/local/bin/seat_test
RUN chmod 755 /usr/local/bin/run_compositor.sh /usr/local/bin/smoke.sh \
        /usr/local/bin/arch_ports_connect_smoke /usr/local/bin/registry_smoke \
        /usr/local/bin/fatal_error_smoke /usr/local/bin/pump_smoke \
        /usr/local/bin/shell_smoke /usr/local/bin/window_smoke /usr/local/bin/seat_test

# ENTRYPOINT + default CMD: `docker run <image>` alone starts the
# compositor on the "glintfx-test" socket; overriding CMD swaps the
# socket name without touching ENTRYPOINT.
ENTRYPOINT ["/usr/local/bin/run_compositor.sh"]
CMD ["glintfx-test"]

# Fact measured live against this exact image, not assumed: Fedora's
# kwin_wayland binary carries the file capability cap_sys_nice=ep
# (`getcap /usr/bin/kwin_wayland`), and a default `docker run` does
# not grant CAP_SYS_NICE - without it, dbus-run-session fails to exec
# kwin_wayland with "Operation not permitted" before the compositor
# ever starts. Every `docker run` of this image, local or CI, needs
# `--cap-drop=ALL --cap-add=SYS_NICE` - the drop-all-then-add-one form
# (not a bare `--cap-add`, adversarial review TEST-WLCONT fix 4) is
# verified live to still start the compositor, and is strictly smaller
# than the default Docker capability set. Nothing else beyond that one
# capability is required: no --privileged, no --pid=host, no
# --device=/dev/dri or any other --device (GODS_LAWS.md L-09 rule 4:
# no real GPU device by default, so the render stays reproducible
# across the whole CI matrix on software rasterization; check_isolation.sh
# allow-lists this exact HostConfig and fails on any wider grant).
